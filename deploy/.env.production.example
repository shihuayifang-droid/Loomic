# HaHart production environment -- template.
#
#   cp deploy/.env.production.example deploy/.env.production
#   then fill in every empty value below.
#
# Loaded by deploy/docker-compose.yml (`env_file: .env.production`) for the
# server and worker services. Never commit real values; this file must stay
# free of legacy hosted-backend keys and of real secrets.
#
# Production runs the self-built providers only (ADR-0001):
#   auth  = self    storage = fs    queue = native

NODE_ENV=production

# ── Database (postgres service in deploy/docker-compose.yml) ─────────
# POSTGRES_PASSWORD is read by the postgres image itself and expanded into
# DATABASE_URL below; compose interpolates it from this file's environment.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://hahart:${POSTGRES_PASSWORD}@postgres:5432/hahart

# ── Auth (self) ─────────────────────────────────────────────────────
HAHART_AUTH_PROVIDER=self
HAHART_AUTH_JWT_SECRET=

# ── Object storage (filesystem volume) ──────────────────────────────
# HAHART_OBJECT_ROOT must stay identical to the `objects` volume mount point
# of the server/worker services in deploy/docker-compose.yml (/data/objects).
HAHART_STORAGE_PROVIDER=fs
HAHART_OBJECT_ROOT=/data/objects
HAHART_OBJECT_URL_SECRET=
HAHART_OBJECT_PUBLIC_BASE=

# ── Job queue (native tables in the same database) ──────────────────
HAHART_QUEUE_PROVIDER=native

# ── Browser origin allowed by CORS ──────────────────────────────────
LOOMIC_WEB_ORIGIN=

# ── Upstream / gateway provider keys ────────────────────────────────
# Names mirror the provider section of the repo-root .env.example; values are
# left empty and are filled per deployment.
OPENAI_API_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
METASO_API_KEY=
